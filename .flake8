[flake8]
# generate_subtasks.py is a one-off codegen script (already run) with long
# embedded markdown templates; excluded rather than reformatted.
max-line-length = 120
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    build,
    dist,
    .eggs,
    *.egg-info,
    scripts/generate_subtasks.py
max-complexity = 12
per-file-ignores =
    __init__.py: F401
